</html>
)rawliteral";

void setup() {
  Serial.begin(115200);

  // Motor pin setup
  pinMode(IN1, OUTPUT); pinMode(IN2, OUTPUT); pinMode(ENA, OUTPUT);
  pinMode(IN3, OUTPUT); pinMode(IN4, OUTPUT); pinMode(ENB, OUTPUT);
  stopMotors();

  // Servo setup (50Hz is standard for SG90/MG996R)
  myServo.setPeriodHertz(50);    
  myServo.attach(servoPin, 500, 2400); 
  myServo.write(90); // Center at startup

  // Connect to WiFi
  WiFi.begin(ssid, password);
  Serial.print("Connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi connected.");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  // Web Server Routes
  server.on("/", []() {
    server.send(200, "text/html", index_html);
  });

  server.on("/motor", handleMotor);
  server.on("/servo", handleServo);

  server.begin();
  Serial.println("Web server started!");
}

void loop() {
  server.handleClient(); // Listen for incoming web requests
}

// --- Handler Functions ---

void handleMotor() {
  if (server.hasArg("dir")) {
    char dir = server.arg("dir").charAt(0);
    
    switch(dir) {
      case 'F': drive(HIGH, LOW, HIGH, LOW, 200); break; // Forward
      case 'B': drive(LOW, HIGH, LOW, HIGH, 200); break; // Backward
      case 'L': drive(LOW, HIGH, HIGH, LOW, 160); break; // Pivot Left
      case 'R': drive(HIGH, LOW, LOW, HIGH, 160); break; // Pivot Right
      case 'S': stopMotors(); break;                     // Stop
    }
    server.send(200, "text/plain", "OK");
  }
}

void handleServo() {
  if (server.hasArg("val")) {
    int angle = server.arg("val").toInt();
    myServo.write(angle);
    server.send(200, "text/plain", "OK");
  }
}

// --- Motor Control Logic ---

void drive(bool in1, bool in2, bool in3, bool in4, int speed) {
  digitalWrite(IN1, in1);
  digitalWrite(IN2, in2);
  analogWrite(ENA, speed);

  digitalWrite(IN3, in3);
  digitalWrite(IN4, in4);
  analogWrite(ENB, speed);
}

void stopMotors() {
  drive(LOW, LOW, LOW, LOW, 0);
}
