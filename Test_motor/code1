#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>

// --- WiFi Credentials ---
const char* ssid = "Premwei";
const char* password = "Premzaza";

WebServer server(80);
Servo myServo;

// --- Motor A (Left) Pins ---
const int IN1 = 26;
const int IN2 = 27;
const int ENA = 14; 

// --- Motor B (Right) Pins ---
const int IN3 = 32;
const int IN4 = 33;
const int ENB = 25; 

// --- Servo Pin ---
const int servoPin = 13;

// --- HTML / CSS / JS Web Page ---
// PROGMEM saves RAM by storing the HTML in flash memory
const char index_html[] PROGMEM = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <title>ESP32 Controller</title>
  <style>
    body { font-family: sans-serif; text-align: center; background: #1a1a1a; color: white; margin-top: 20px; user-select: none; }
    h2 { color: #00ffcc; }
    .grid { display: grid; grid-template-columns: repeat(3, 80px); gap: 10px; justify-content: center; margin: 30px auto; }
    .btn { width: 80px; height: 80px; font-size: 24px; font-weight: bold; border-radius: 12px; border: none; background: #333; color: white; box-shadow: 0 4px #111; cursor: pointer; touch-action: none; }
    .btn:active { background: #00ffcc; color: black; box-shadow: 0 0px #111; transform: translateY(4px); }
    .empty { background: transparent; box-shadow: none; pointer-events: none; }
    .slider { width: 80%; max-width: 300px; margin: 20px 0; }
  </style>
  <script>
    // Fetch requests send commands without reloading the page
    function req(url) { fetch(url).catch(e => console.log(e)); }
    
    // Motor control function (handles both touch and mouse clicks)
    function m(dir, e) {
      if(e) e.preventDefault(); // Prevents ghost clicks on mobile
      req('/motor?dir=' + dir);
    }
    
    // Servo slider function
    function s(val) {
      document.getElementById('ang').innerText = val;
      req('/servo?val=' + val);
    }
    
    // Disables the long-press pop-up menu on phones
    window.oncontextmenu = function() { return false; }; 
  </script>
</head>
<body>
  <h2>RC Control Panel</h2>
  
  <div class="grid">
    <div class="empty"></div>
    <button class="btn" ontouchstart="m('F', event)" ontouchend="m('S', event)" onmousedown="m('F')" onmouseup="m('S')">W</button>
    <div class="empty"></div>
    
    <button class="btn" ontouchstart="m('L', event)" ontouchend="m('S', event)" onmousedown="m('L')" onmouseup="m('S')">A</button>
    <button class="btn" style="background:#dc3545; box-shadow:0 4px #8b1c26;" onmousedown="m('S')" ontouchstart="m('S', event)">S</button>
    <button class="btn" ontouchstart="m('R', event)" ontouchend="m('S', event)" onmousedown="m('R')" onmouseup="m('S')">D</button>
    
    <div class="empty"></div>
    <button class="btn" ontouchstart="m('B', event)" ontouchend="m('S', event)" onmousedown="m('B')" onmouseup="m('S')">X</button>
    <div class="empty"></div>
  </div>

  <h2>Servo: <span id="ang">90</span>&deg;</h2>
  <input type="range" min="0" max="180" value="90" class="slider" oninput="s(this.value)">
