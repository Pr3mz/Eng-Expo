#include <WiFi.h>
#include <WiFiUDP.h>
#include <TFT_eSPI.h>
#include <InEngMotor.h>

// ==========================================
//               CONFIGURATION
// ==========================================
const char *ssid = "Premwei";
const char *password = "Premzaza";

const int UDP_PORT = 4210;

// Hardware Pins
const int LEFT_ARM_PIN = 19;
const int RIGHT_ARM_PIN = 32;

// LEDC Channels for Servos (Avoid 0-3 used by InEngMotor)
const int LEFT_ARM_CH = 4;
const int RIGHT_ARM_CH = 5;

// Speed limits
const int MAX_SPEED = 100;

// ==========================================
//               GLOBALS
// ==========================================
WiFiUDP udp;
TFT_eSPI tft = TFT_eSPI();

int currentLeftSpeed = 0;
int currentRightSpeed = 0;

unsigned long lastUdpTime = 0;
const unsigned long UDP_TIMEOUT_MS = 500;

// --- Native LEDC Servo Wrapper (Core 2.x) ---
void servoWrite(int channel, int angle)
{
  int pulseWidth = map(angle, 0, 180, 500, 2500);
  uint32_t duty = (pulseWidth * 65535UL) / 20000UL;
  ledcWrite(channel, duty);
}

// ==========================================
//               SETUP
// ==========================================
void setup()
{
  Serial.begin(115200);

  tft.init();
  tft.setRotation(1);
  tft.fillScreen(TFT_BLACK);
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.setTextSize(2);

  // Initialize DC Motors (Reserves LEDC 0, 1, 2, 3)
  inengmotor.begin();

  // Initialize Servos (Core 2.x native LEDC)
  ledcSetup(LEFT_ARM_CH, 50, 16);
  ledcAttachPin(LEFT_ARM_PIN, LEFT_ARM_CH);

  ledcSetup(RIGHT_ARM_CH, 50, 16);
  ledcAttachPin(RIGHT_ARM_PIN, RIGHT_ARM_CH);

  // Start CLOSED (0 degrees)
  servoWrite(LEFT_ARM_CH, 0);
  servoWrite(RIGHT_ARM_CH, 0);

  // Connect WiFi
  WiFi.begin(ssid, password);
  tft.println("Connecting WiFi...");
  while (WiFi.status() != WL_CONNECTED)
  {
    delay(500);
  }

  tft.fillScreen(TFT_BLACK);
  tft.setCursor(0, 0);
  tft.setTextColor(TFT_CYAN, TFT_BLACK);
  tft.println("ESP32 ONLINE");
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.println(WiFi.localIP().toString());

  udp.begin(UDP_PORT);
  Serial.println("UDP Ready");
}

// ==========================================
//               MAIN LOOP
// ==========================================
void loop()
{
  // 1. Drain UDP Queue — keep LAST packet only
  char incomingPacket[64] = {0};
  bool gotPacket = false;

  int packetSize = udp.parsePacket();
  while (packetSize)
  {
    int len = udp.read(incomingPacket, 63);
    if (len > 0)
    {
      incomingPacket[len] = '\0';
      gotPacket = true;
      lastUdpTime = millis();
    }
    packetSize = udp.parsePacket();
  }

  // 2. Timeout Safety — stop if no packets for 500ms
  if (millis() - lastUdpTime > UDP_TIMEOUT_MS)
  {
    currentLeftSpeed = 0;
    currentRightSpeed = 0;
    inengmotor.drive(0, 0);
    return;
  }

  // 3. Process the LAST received packet
  if (gotPacket)
  {
    char cmd = incomingPacket[0];

    switch (cmd)
    {
    case 'M':
    {
      // Proportional: M,leftSpeed,rightSpeed
      int lSpeed = 0, rSpeed = 0;
      if (sscanf(incomingPacket, "M,%d,%d", &lSpeed, &rSpeed) == 2)
      {
        // Clamp to safe range
        lSpeed = constrain(lSpeed, -MAX_SPEED, MAX_SPEED);
        rSpeed = constrain(rSpeed, -MAX_SPEED, MAX_SPEED);
        currentLeftSpeed = lSpeed;
        currentRightSpeed = rSpeed;
      }
      break;
    }
    case 'F':
      currentLeftSpeed = MAX_SPEED;
      currentRightSpeed = MAX_SPEED;
      break;
    case 'B':
      currentLeftSpeed = -MAX_SPEED;
      currentRightSpeed = -MAX_SPEED;
      break;
    case 'L':
      currentLeftSpeed = -MAX_SPEED;
      currentRightSpeed = MAX_SPEED;
      break;
    case 'R':
      currentLeftSpeed = MAX_SPEED;
      currentRightSpeed = -MAX_SPEED;
      break;
    case 'S':
      currentLeftSpeed = 0;
      currentRightSpeed = 0;
      break;
    case 'C':
      servoWrite(LEFT_ARM_CH, 180);
      servoWrite(RIGHT_ARM_CH, 180);
      break;
    case 'O':
      servoWrite(LEFT_ARM_CH, 0);
      servoWrite(RIGHT_ARM_CH, 0);
      break;
    }

    // Drive motors IMMEDIATELY — no LERP delay
    inengmotor.drive(currentLeftSpeed, currentRightSpeed);
  }
}
